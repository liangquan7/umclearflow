<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FAFC">

    <!-- 顶部标题栏 + 真实 SOS 按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0F172A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UM-ClearFlow • Flood &amp; Hazard GIS"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_map_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading active campus hazards..."
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_sos"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="#DC2626"
            android:text="SOS 999 / GPS"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- FR 1.3 管理员应急广播横幅 -->
    <TextView
        android:id="@+id/tv_broadcast_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FEF3C7"
        android:padding="8dp"
        android:textColor="#92400E"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- FR 4.1 筛选与避难所图层控制栏 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_filter_all"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="All"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_filter_critical"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="Critical Only"
                android:textSize="11sp" />

            <CheckBox
                android:id="@+id/cb_show_shelters"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:checked="true"
                android:text="Shelters Layer"
                android:textColor="#0F172A"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/cb_evac_route"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Safe Route"
                android:textColor="#0F172A"
                android:textSize="12sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- FR 4.2 起终点选择器 + 避障路由状态栏 -->
    <LinearLayout
        android:id="@+id/layout_route_selector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#EFF6FF"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="From: "
                android:textColor="#1E3A8A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinner_origin"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="To: "
                android:textColor="#1E3A8A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinner_destination"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_route_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Select origin and shelter to compute flood-safe route."
            android:textColor="#1E40AF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- OSM 交互式地图容器 -->
    <org.osmdroid.views.MapView
        android:id="@+id/osm_map"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>