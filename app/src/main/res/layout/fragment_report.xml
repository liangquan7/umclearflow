<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crowdsourced Hazard Reporting"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="FR 2.1 GPS &amp; Camera • FR 2.2 Community Verify • FR 3.1 Vision Triage"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <!-- 上报表单卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Campus Location &amp; Live GPS"
                android:textColor="#1E293B"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinner_location"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_acquire_gps"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="📍 Get Real GPS"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tv_gps_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Using landmark coordinates"
                    android:textColor="#475569"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="2. Hazard Category"
                android:textColor="#1E293B"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinner_hazard_type"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp" />

            <EditText
                android:id="@+id/et_report_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Short Hazard Title (e.g., ankle-deep flood near bus stop)"
                android:inputType="textCapSentences"
                android:textColor="#0F172A"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_report_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="Details (water depth, blocked lane, landmarks...)"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:textColor="#0F172A"
                android:textSize="13sp" />

            <!-- 拍照预览与视觉分诊区 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_capture_photo"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="📷 Capture Photo"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_ai_triage"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:backgroundTint="#2563EB"
                    android:text="🔍 Run Vision Scan"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_photo_preview"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="8dp"
                android:background="#E2E8F0"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_triage_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#EFF6FF"
                android:padding="10dp"
                android:text="Capture a photo and tap 'Run Vision Scan' to evaluate severity."
                android:textColor="#1E3A8A"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="🔒 PDPA Notice: Location &amp; photo are used solely for UM campus flood safety. Avoid capturing faces or license plates."
                android:textColor="#64748B"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_submit_report"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#16A34A"
                android:text="Submit Hazard Report (Saved to SQLite)"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- FR 2.3 工单筛选栏：全部上报 vs 我的上报 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Live Ticket Queue"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_tab_all_reports"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:text="All Campus"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_tab_my_reports"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="My Reports"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- 动态工单列表容器 -->
        <LinearLayout
            android:id="@+id/reports_list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>