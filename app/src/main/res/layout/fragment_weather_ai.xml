<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FA"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 卡片 1：实时 Open-Meteo 马大内涝与降雨气象预测 (Module 3 FR3.2) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#002B5B"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    text="☁️ UM Live Climate &amp; Flood Risk Sentinel"
                    android:text="☁️ UM Live Climate &amp; Flood Risk Sentinel"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWeatherStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="#103F73"
                    android:padding="12dp"
                    android:text="Fetching live Open-Meteo weather data for Universiti Malaya (Latitude: 3.1209)..."
                    android:textColor="#E3F2FD"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnRefreshWeather"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#1976D2"
                    android:text="🔄 Refresh Weather API"
                    android:textSize="11sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 卡片 2：校园应急 AI 智能助手 (Module 3 FR3.3) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🤖 UM Emergency AI Assistant"
                    android:textColor="#002B5B"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Ask questions about campus flood safety, blocked drains, or JPPHB emergency contacts."
                    android:textColor="#666666"
                    android:textSize="12sp" />

                <!-- AI 对话输出框 -->
                <TextView
                    android:id="@+id/tvAiChatResponse"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="8dp"
                    android:background="#F3E5F5"
                    android:padding="10dp"
                    android:scrollbars="vertical"
                    android:text="Hello! I am your UM Climate &amp; Drainage AI Assistant. Tap a quick prompt below to test."
                    android:textColor="#4A148C"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnPrompt1"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:backgroundTint="#7B1FA2"
                        android:text="⚡ Flood Safety"
                        android:textSize="10sp" />

                    <Button
                        android:id="@+id/btnPrompt2"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:backgroundTint="#7B1FA2"
                        android:text="🌳 Fallen Tree"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 卡片 3：校园隐患高频排行榜与统计看板 (Module 5) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 Campus Climate Resilience Analytics"
                    android:textColor="#002B5B"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAnalyticsSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="• Most Prone Zone: Jalan Lingkungan Budi (KL Gate)\n• Total Active Hazards: 4 Incidents\n• Average JPPHB Resolution Time: 2.4 Hours\n• SDG 13.1 Target Alignment: Active &amp; Monitored"
                    android:textColor="#333333"
                    android:textSize="13sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>