<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Weather Estimates &amp; Campus Safety Guide"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Weather forecast • Local rule-based estimates • Device notifications"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <!-- FR 3.2 & 5.3 实时气象与6小时预报融合卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. Open-Meteo 6-Hour Forecast &amp; Flood Risk Fusion"
                android:textColor="#1E293B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_weather_live"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#F1F5F9"
                android:padding="10dp"
                android:text="Loading Open-Meteo telemetry..."
                android:textColor="#0F172A"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_risk_matrix"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#FEF2F2"
                android:padding="10dp"
                android:text="Computing illustrative zone risk estimates from weather data and local reports..."
                android:textColor="#991B1B"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_refresh_weather"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="🔄 Live API Sync"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btn_simulate_squall"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:backgroundTint="#DC2626"
                    android:text="⛈️ Simulate Squall Alert"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Background WorkManager Weather Alerts toggle & status -->
            <CheckBox
                android:id="@+id/cb_bg_weather_alerts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:minHeight="48dp"
                android:text="Background weather alerts (~15 min via WorkManager)"
                android:textColor="#1E293B"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_bg_alert_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Background check: waiting for first run..."
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- FR 3.3 交互式 AI 应急聊天助手卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. Rule-Based Campus Safety Guide"
                android:textColor="#1E293B"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- 快捷提问按钮栏 -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_prompt_shelter"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:text="Nearest Shelters?"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_prompt_route"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:text="Safe Route Status?"
                        android:textSize="11sp" />

                    <Button
                        android:id="@+id/btn_prompt_sos"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="Emergency Contacts"
                        android:textSize="11sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tv_chat_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#EFF6FF"
                android:padding="12dp"
                android:textColor="#1E3A8A"
                android:textSize="12sp" />

            <!-- 真实聊天输入框 + 发送按钮 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_chat_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Ask about shelters, flooded roads, or SOP..."
                    android:inputType="textCapSentences"
                    android:textColor="#0F172A"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_send_chat"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:backgroundTint="#2563EB"
                    android:text="Send"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
